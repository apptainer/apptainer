Bootstrap: docker
From: {{ BASEIMAGE }}

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get -q update && apt-get -q install -y \
      ca-certificates \
      tzdata \
      libfuse3-dev \
      liblzma-dev \
      liblzo2-dev \
      liblz4-dev \
      libzstd-dev \
      libtalloc-dev \
      libprotobuf-c-dev \
      zlib1g-dev

%runscript
    /usr/local/bin/apptainer "$@"
